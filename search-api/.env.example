# ── Server ────────────────────────────────────────────────────────────────────
PORT=3210

# ── Auth ──────────────────────────────────────────────────────────────────────
# If set, every request must include the header: X-Api-Key: <value>
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all (dev only).
# Example: https://quickart.app,chrome-extension://abcdefghijklmno
ALLOWED_ORIGINS=*

# ── Rate limiting (requests per minute per IP) ────────────────────────────────
RATE_LIMIT_SEARCH=20
RATE_LIMIT_ETA=10

# ── Concurrency ───────────────────────────────────────────────────────────────
# Max simultaneous in-flight /api/search or /api/eta requests.
# Keep at 2-3 on e2-medium (Chromium is memory-hungry).
MAX_CONCURRENT=3

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Set to 1 if a trusted reverse proxy (e.g. GCP Load Balancer, nginx) sits in
# front — enables X-Forwarded-For for real client IPs in rate limiting.
TRUST_PROXY=0

# ── ETA cache ─────────────────────────────────────────────────────────────────
# Set to 0 to disable in-memory ETA caching (useful during development).
ETA_CACHE=1

# ── Flipkart Rome API (optional) ──────────────────────────────────────────────
# Raw Cookie header for direct ETA fetch (2.rome.api.flipkart.com). If unset,
# cookies are loaded from .session-cache/flipkart-cookies.json after a browser run.
# FLIPKART_COOKIE=
