<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/dismiss_image"
                android:layout_width="20dp"
                android:layout_height="50dp"
                android:layout_marginLeft="16dp"
                android:src="@drawable/ic_action_cross"
                android:layout_alignParentLeft="true"/>
            <ImageView
                android:id="@+id/npciLogo"
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:layout_marginRight="16dp"
                android:src="@drawable/ic_upi_npci_logo"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="25dp"
            android:textColor="@color/npci_text_red"
            android:gravity="center"
            android:paddingLeft="30dp"
            android:paddingTop="40dp"
            android:paddingRight="30dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_not_available"
            android:layout_below="@+id/npciLogo"
            android:textAlignment="center"/>
        <TextView
            android:textSize="15dp"
            android:gravity="center"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_check_message"
            android:layout_below="@+id/npciLogo"
            android:textAlignment="center"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/refereshPage"
            android:background="@drawable/custom_rounded_btn_theme"
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:paddingRight="20dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/ic_action_reload_white"/>
            <TextView
                android:textSize="20dp"
                android:textColor="@color/npci_text_primary_light"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refresh_page"/>
        </LinearLayout>
        <TextView
            android:textSize="14dp"
            android:gravity="center"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/referesh_message"
            android:layout_below="@+id/npciLogo"
            android:textAlignment="center"/>
    </LinearLayout>
</RelativeLayout>
