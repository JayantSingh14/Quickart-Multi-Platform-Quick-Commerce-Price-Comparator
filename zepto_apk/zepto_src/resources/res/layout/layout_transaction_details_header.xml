<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/transaction_info_root"
    android:background="@drawable/transaction_details_root_bg"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/transaction_bar_root">
            <ScrollView
                android:id="@+id/transaction_details_scroller"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/transaction_details_root"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </ScrollView>
            <View
                android:id="@+id/transaction_details_expanded_space"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/transaction_bar_root"
            android:background="@color/npci_keypad_bg_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:layoutDirection="ltr"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_transaction_header_fields"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/primary_black"
                        android:id="@+id/transaction_payee_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/to"
                        android:singleLine="true"
                        android:fontFamily="sans-serif"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/primary_black"
                        android:id="@+id/transaction_amount_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sending"
                        android:singleLine="true"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.45"
                    android:paddingEnd="8dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_black"
                        android:ellipsize="end"
                        android:layout_gravity="end"
                        android:id="@+id/transaction_payee_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:fontFamily="sans-serif"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_black"
                        android:ellipsize="end"
                        android:layout_gravity="end"
                        android:id="@+id/transaction_amount_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/transaction_bar_arrow"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:src="0x7f08026c"
                    android:tint="@color/primary_black"
                    android:layout_weight="0.05"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
